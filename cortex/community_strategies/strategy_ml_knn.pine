/*
 * COMMUNITY STRATEGY: Machine Learning k-Nearest Neighbors (kNN)
 * AUTHOR: QuantForge Community Pack
 * SOURCE: Capissimo Logic
 */
//@version=6
strategy("COMMUNITY: ML kNN Pattern Recognition [QuantForge]", overlay = true, process_orders_on_close = true)

// --- SETTINGS ---
int k_param = input.int(5, "k Neighbors")
int window = input.int(20, "Lookback Window")

// --- LOGIC: FEATURE ENGINEERING ---
// We use RSI, CCI, and ROC as features for the ML model
f1 = ta.rsi(close, 14) 
f2 = ta.cci(close, 14)
f3 = ta.roc(close, 10)

// Classify current candle: 1 = Bullish, -1 = Bearish
int class_label = close > close[1] ? 1 : -1

// --- LOGIC: SIMULATED kNN (Distance Calculation) ---
// Note: True kNN in Pine is computationally heavy. This is a simplified "Recent Neighbor" Approach.
// We look for the 'k' most similar candles in the last 'window' bars.

float prediction = 0.0

for i = 1 to window
    // Calculate Euclidean Distance between current features and past features
    float d = math.sqrt(math.pow(f1 - f1[i], 2) + math.pow(f2 - f2[i], 2) + math.pow(f3 - f3[i], 2))
    
    // Weight by inverse distance (closer = more important)
    float weight = 1.0 / (d + 0.001)
    prediction += class_label[i] * weight

// --- EXECUTION ---
if prediction > 0
    strategy.entry("ML Long", strategy.long)
if prediction < 0
    strategy.entry("ML Short", strategy.short)

// Trailing Switch to close
if prediction < 0 and strategy.position_size > 0
    strategy.close("ML Long")
if prediction > 0 and strategy.position_size < 0
    strategy.close("ML Short")
